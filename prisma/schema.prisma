generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"] // ⚡ Idagdag ito para suportahan ang pgvector
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector]
}


model Store {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  // STEP 3: STORE CONFIGURATION & DESIGN
  name             String
  slug             String   @unique
  themeColor       String   @default("#E8A33D") @map("theme_color")
  logoUrl          String?  @map("logo_url")
  backgroundPreset String   @default("bg-slate-50") @map("background_preset")
  status           String   @default("active")

  // STEP 1 & AUTH CONNECTIONS
  ownerId          String   @map("owner_id") @db.Uuid
  ownerName        String   @map("owner_name")

  // STEP 2: BUSINESS IDENTITY & COURIER
  businessName     String   @map("business_name")
  businessType     String   @default("Single Proprietorship") @map("business_type")
  contactNumber    String   @map("contact_number")
  pickupAddress    String   @map("pickup_address")

  @@map("stores") // Ipinapantay nito ang pangalan ng model sa 'stores' table sa SQL
}

model SignupCustomer {
  // Ang ID ay String/UUID na manggagaling mismo sa Supabase Auth User ID pagkatapos ng OTP verification
  id           String   @id
  
  // Account Details (Dito papasok ang Gmail/Email ng Customer)
  email        String   @unique
  fullName     String   @map("full_name")
  
  // Contact Numbers (Mahalaga para sa mga riders at notifications)
  phone        String
  altPhone     String?  @map("alt_phone") // Nullable dahil opsyonal ito sa form mo

  // Structured Delivery Address (Hiwa-hiwalay para sa courier utility at label generation)
  street       String
  barangay     String
  city         String   @map("city_municipality")
  province     String
  zipCode      String   @map("zip_code")

  // System Audit Timestamps
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  // Nilalagyan natin ito ng @@map para ang pangalan ng table sa iyong PostgreSQL/Supabase ay maging malinis na snake_case
  @@map("signup_customers")
}

model OtpVerification {
  id        String   @id @default(uuid())
  email     String   
  code      String   // Dito itatabi ang 6-digit number (e.g., "123456")
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otp_verifications")
}
model StoreKnowledge {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  content   String   // Ang mismong purong teksto (hal. "Ang Store X ay nagbebenta ng sapatos mula 9 AM hanggang 6 PM")
  
  embedding Unsupported("vector(3072)")? 

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("store_knowledge")
}

model ChatSession {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String?       @map("customer_id") // Nullable kung hindi naka-login ang nagcha-chat
  storeId    String?       @map("store_id") @db.Uuid // Kung nakatutok ang chat sa isang partikular na tindahan
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz
  messages   ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String      @map("session_id") @db.Uuid
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String      // "user" o "assistant"
  content   String      // Ang mensahe
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@map("chat_messages")
}



