 // prisma/schema.prisma

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"] // Naaayon sa iyong pgvector setup
}

datasource db {
  provider   = "postgresql"
  extensions = [pgvector]
}

model Store {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  // STORE CONFIGURATION & DESIGN
  name             String
  slug             String   @unique
  themeColor       String   @default("#E8A33D") @map("theme_color")
  logoUrl          String?  @map("logo_url")
  backgroundPreset String   @default("bg-slate-50") @map("background_preset")
  status           String   @default("active")

  // AUTH CONNECTIONS
  ownerId          String   @map("owner_id") @db.Uuid
  ownerName        String   @map("owner_name")

  // BUSINESS IDENTITY & COURIER
  businessName     String   @map("business_name")
  businessType     String   @default("Single Proprietorship") @map("business_type")
  contactNumber    String   @map("contact_number")
  pickupAddress    String   @map("pickup_address")

  // MULTI-TENANT BACK-END RELATIONS
  categories       Category[]
  products         Product[]
  chatSessions     ChatSession[]
  storeKnowledge   StoreKnowledge[]

  orders           Order[]

  @@map("stores")
}

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   // Para sa marketplace routing at filtering
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // RELATIONS
  storeId   String   @map("store_id") @db.Uuid
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([storeId, slug]) // Hindi pwedeng magka-pareho ng slug ang dalawang kategorya sa iisang tindahan
  @@map("categories")
}

model Product {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?  @db.Text
  images      String[] // Array ng Cloudinary URLs para sa maramihang larawan
  status      String   @default("draft") // "draft" o "published"
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // RELATIONS
  storeId     String   @map("store_id") @db.Uuid
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  
  categoryId  String   @map("category_id") @db.Uuid
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  variants    ProductVariant[] // Dito nakakabit ang iyong inventory at SKU layer

  @@map("products")
}

model ProductVariant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   // Halimbawa: "Red / Size 9" o "Standard"
  sku       String   @unique // Natatanging business identifier para sa imbentaryo
  price     Decimal  @default(0.00) @db.Decimal(10, 2) // Swak sa e-commerce para walang rounding errors ang pera
  stock     Int      @default(0) // Ang iyong core inventory tracking count
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // RELATIONS
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  orderItems OrderItem[] 

  @@map("product_variants")
}

model SignupCustomer {
  id           String   @id
  email        String   @unique
  fullName     String   @map("full_name")
  phone        String
  altPhone     String?  @map("alt_phone")
  street       String
  barangay     String
  city         String   @map("city_municipality")
  province     String
  zipCode      String   @map("zip_code")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("signup_customers")
}

model OtpVerification {
  id        String   @id @default(uuid())
  email     String   
  code      String   
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otp_verifications")
}

model StoreKnowledge {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeId   String   @map("store_id") @db.Uuid
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  content   String   
  embedding Unsupported("vector(3072)")? 
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@map("store_knowledge")
}

model ChatSession {
  id         String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId String?       @map("customer_id") 
  storeId    String?       @map("store_id") @db.Uuid 
  store      Store?        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt  DateTime      @default(now()) @map("created_at") @db.Timestamptz
  messages   ChatMessage[]

  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sessionId String      @map("session_id") @db.Uuid
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      String      
  content   String      
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz

  @@map("chat_messages")
}

model Order {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber     String   @unique @map("order_number")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz
  subtotal        Decimal  @db.Decimal(10, 2)
  shippingFee     Decimal  @default(0.00) @map("shipping_fee") @db.Decimal(10, 2)
  discount        Decimal  @default(0.00) @db.Decimal(10, 2)
  totalAmount     Decimal  @map("total_amount") @db.Decimal(10, 2)
  paymentStatus   String   @default("pending") @map("payment_status")
  shippingStatus  String   @default("unfulfilled") @map("shipping_status")
  customerName    String   @map("customer_name")
  customerEmail   String   @map("customer_email")
  customerPhone   String   @map("customer_phone")
  shippingAddress String   @map("shipping_address") @db.Text
  notes           String?  @db.Text
  storeId         String   @map("store_id") @db.Uuid
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]

  @@index([storeId])
  @@map("orders")
}

model OrderItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quantity        Int      @default(1)
  priceAtPurchase Decimal  @map("price_at_purchase") @db.Decimal(10, 2)
  productName     String   @map("product_name")
  variantName     String   @map("variant_name")
  variantSku      String   @map("variant_sku")
  orderId         String   @map("order_id") @db.Uuid
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId       String?  @map("variant_id") @db.Uuid
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("order_items")
}
