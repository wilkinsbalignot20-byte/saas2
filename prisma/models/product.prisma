 // prisma/models/product.prisma

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   // Para sa marketplace routing at filtering
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // RELATIONS
  storeId   String   @map("store_id") @db.Uuid
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([storeId, slug]) // Hindi pwedeng magka-pareho ng slug ang dalawang kategorya sa iisang tindahan
  @@map("categories")
}

model Product {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?  @db.Text
  images      String[] // Array ng Cloudinary URLs para sa maramihang larawan
  status      String   @default("draft") // "draft" o "published"
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // RELATIONS
  storeId     String   @map("store_id") @db.Uuid
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  
  categoryId  String   @map("category_id") @db.Uuid
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  variants    ProductVariant[] // Dito nakakabit ang iyong inventory at SKU layer

  @@map("products")
}

model ProductVariant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   // Halimbawa: "Red / Size 9" o "Standard"
  sku       String   @unique // Natatanging business identifier para sa imbentaryo
  price     Decimal  @default(0.00) @db.Decimal(10, 2) // Swak sa e-commerce para walang rounding errors ang pera
  stock     Int      @default(0) // Ang iyong core inventory tracking count
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // RELATIONS
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  orderItems OrderItem[] 

  @@map("product_variants")
}

// 🌟 PINAG-ISA AT INAYOS: Tinanggal ang duplicate card at isinama ang bagong choices array link block
model ProductBundle {
  id          String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   
  description String?             @db.Text
  status      String              @default("draft") // "draft" o "published"
  createdAt   DateTime            @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime            @updatedAt @map("updated_at") @db.Timestamptz
  bundleType  String              @default("MIX_AND_MATCH") // "MIX_AND_MATCH" o "FIXED_PACKAGE"

  // RELATIONS
  storeId     String              @map("store_id") @db.Uuid
  store       Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  
  // Pinapayagang sub-packages (Dito nakasalalay ang Bundle of 3, 5, atbp. na may sariling Cloudinary images)
  tiers       ProductBundleTier[]
  
  // Ang mga standalone single item options (flavors/variants) na nilikha mismo sa loob ng bundle
  choices     BundleItemChoice[]

  @@map("product_bundles")
}

model ProductBundleTier {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quantity  Int           // Dito ilalagay kung 3, 5, o kahit ilang piraso ang trip ng tenant
  price     Decimal       @default(0.00) @db.Decimal(10, 2) // Ang presyo na itinakda ni tenant para sa tier na ito
  images    String[]      // Cloudinary group photo para sa partikular na bundle size na ito
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz

  // RELATIONS
  bundleId  String        @map("bundle_id") @db.Uuid
  bundle    ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@map("product_bundle_tiers")
}

model BundleItemChoice {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String        // Halimbawa: "Flavor Premium A", "Sachet Variant 1"
  
  // 🌟 INAYOS DITO: Idinagdag ang @map sa tabi ng imageUrl
  imageUrl    String        @map("image_url") 
  
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz

  // RELATIONS
  bundleId    String        @map("bundle_id") @db.Uuid
  bundle      ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)

  @@map("bundle_item_choices")
}

