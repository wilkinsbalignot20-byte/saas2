 // prisma/models/product.prisma

model Category {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String
  slug      String   // Para sa marketplace routing at filtering
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // RELATIONS
  storeId   String   @map("store_id") @db.Uuid
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  products  Product[]

  @@unique([storeId, slug]) // Hindi pwedeng magka-pareho ng slug ang dalawang kategorya sa iisang tindahan
  @@map("categories")
}

model Product {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?  @db.Text
  images      String[] // Array ng Cloudinary URLs para sa maramihang larawan
  status      String   @default("draft") // "draft" o "published"
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // RELATIONS
  storeId     String   @map("store_id") @db.Uuid
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  
  categoryId  String   @map("category_id") @db.Uuid
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  
  variants    ProductVariant[] // Dito nakakabit ang iyong inventory at SKU layer
  
  // 🌟 INAYOS: Kumokonekta na sa junction table para sa multi-product selection tags
  bundleLinks BundleProduct[]

  @@map("products")
}

model ProductVariant {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name      String   // Halimbawa: "Red / Size 9" o "Standard"
  sku       String   @unique // Natatanging business identifier para sa imbentaryo
  price     Decimal  @default(0.00) @db.Decimal(10, 2) // Swak sa e-commerce para walang rounding errors ang pera
  stock     Int      @default(0) // Ang iyong core inventory tracking count
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // RELATIONS
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  orderItems OrderItem[] 

  @@map("product_variants")
}

model ProductBundle {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String   // Halimbawa: "Ultimate Flavor Trio Pack", "Buy 5 Promo Mix"
  quantity    Int      @default(1) // Ilang pcs ang kailangang piliin ng customer (e.g., 3, 5 items)
  price       Decimal  @default(0.00) @db.Decimal(10, 2) // Ang espesyal na package price para sa bundle na ito
  images      String[] // 🌟 IDINAGDAG: Array ng Cloudinary URLs para sa group photo ng promo board
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // RELATIONS
  // 🌟 INAYOS: Kumokonekta na sa junction array framework para sa multi-product mapping records
  includedProducts BundleProduct[]

  // IDINAGDAG: Kailangan din natin i-tag kung aling store/tenant ang may-ari ng bundle promo code na ito
  storeId     String   @map("store_id") @db.Uuid
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  @@map("product_bundles")
}

// 🌟 BAGONG MODEL LAYER CONTEXT: Junction model para sa many-to-many product linkage orchestration
model BundleProduct {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  bundleId  String   @map("bundle_id") @db.Uuid
  bundle    ProductBundle @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  
  productId String   @map("product_id") @db.Uuid
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@unique([bundleId, productId])
  @@map("bundle_products")
}
