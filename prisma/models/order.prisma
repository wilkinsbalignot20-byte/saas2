// prisma/models/order.prisma

model Order {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderNumber     String   @unique @map("order_number")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz
  subtotal        Decimal  @db.Decimal(10, 2)
  shippingFee     Decimal  @default(0.00) @map("shipping_fee") @db.Decimal(10, 2)
  discount        Decimal  @default(0.00) @db.Decimal(10, 2)
  totalAmount     Decimal  @map("total_amount") @db.Decimal(10, 2)
  paymentStatus   String   @default("pending") @map("payment_status")
  shippingStatus  String   @default("unfulfilled") @map("shipping_status")
  customerName    String   @map("customer_name")
  customerEmail   String   @map("customer_email")
  customerPhone   String   @map("customer_phone")
  shippingAddress String   @map("shipping_address") @db.Text
  notes           String?  @db.Text
  storeId         String   @map("store_id") @db.Uuid
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems      OrderItem[]

  // 🚚 BAGO: DELIVERY / DISPATCH TRACKING FIELDS
  courierId       String?   @map("courier_id") @db.Uuid
  courier         Courier?  @relation(fields: [courierId], references: [id], onDelete: SetNull)
  dispatchedAt    DateTime? @map("dispatched_at") @db.Timestamptz
  deliveredAt     DateTime? @map("delivered_at") @db.Timestamptz

  @@index([storeId])
  @@index([courierId]) // 🚚 BAGO: Index para sa mabilis na paghahanap ng orders ng rider
  @@map("orders")
}

model Courier {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  phone         String
  vehicleType   String   @default("Motorcycle") @map("vehicle_type")
  plateNumber   String?  @map("plate_number")
  status        String   @default("available")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz

  // TENANT ISOLATION GUARD: Naka-lock sa iisang tindahan
  storeId       String   @map("store_id") @db.Uuid
  store         Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)

  // 🚚 BAGO: Malinis at aktibong back-relation array (Ito ang naging malabo sa gawa ni Claude)
  orders        Order[]

  @@index([storeId]) // 🚚 BAGO: Index para sa mabilis na pag-load ng fleet per store
  @@map("couriers")
}

model OrderItem {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  quantity        Int      @default(1)
  priceAtPurchase Decimal  @map("price_at_purchase") @db.Decimal(10, 2)
  productName     String   @map("product_name")
  variantName     String   @map("variant_name")
  variantSku      String   @map("variant_sku")
  
  orderId         String   @map("order_id") @db.Uuid
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  variantId       String?  @map("variant_id") @db.Uuid
  variant         ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@map("order_items")
}
