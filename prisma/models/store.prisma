// prisma/models/store.prisma

model Store {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz

  // STORE CONFIGURATION & DESIGN
  name             String
  slug             String   @unique
  themeColor       String   @default("#E8A33D") @map("theme_color")
  logoUrl          String?  @map("logo_url")
  backgroundPreset String   @default("bg-slate-50") @map("background_preset")
  status           String   @default("active")

  // AUTH CONNECTIONS
  ownerId          String   @map("owner_id") @db.Uuid
  ownerName        String   @map("owner_name")

  // BUSINESS IDENTITY & COURIER
  businessName     String   @map("business_name")
  businessType     String   @default("Single Proprietorship") @map("business_type")
  contactNumber    String   @map("contact_number")
  pickupAddress    String   @map("pickup_address")

  // MULTI-TENANT BACK-END RELATIONS
  categories       Category[]
  products         Product[]
  chatSessions     ChatSession[]
  storeKnowledge   StoreKnowledge[]

  orders           Order[]
  couriers         Courier[]
  vouchers         Voucher[]
  campaigns        Campaign[]

  fbPageId          String?  @map("fb_page_id")
  fbPageAccessToken String?  @map("fb_page_access_token") @db.Text

  slackWebhookUrl   String?  @map("slack_webhook_url") @db.Text
  viberBotToken     String?  @map("viber_bot_token") @db.Text
  bannerUrl         String?  @map("banner_url") @db.Text
  promoVideoUrl     String?  @map("promo_video_url") @db.Text
  promoText         String?  @map("promo_text") @db.Text

  @@map("stores")
}
